FROM public.ecr.aws/lambda/python:3.13
WORKDIR ${LAMBDA_TASK_ROOT}
ARG LAMBDA_HANDLER
ENV LAMBDA_HANDLER=${LAMBDA_HANDLER}
COPY requirements-lambda.txt .
RUN pip install --no-cache-dir -r requirements-lambda.txt
COPY src/ ${LAMBDA_TASK_ROOT}/src/
COPY docker/lambda-entrypoint.sh ${LAMBDA_TASK_ROOT}/lambda-entrypoint.sh
RUN chmod +x ${LAMBDA_TASK_ROOT}/lambda-entrypoint.sh
ENTRYPOINT ["/var/task/lambda-entrypoint.sh"]
CMD ["src.functions.coletor.handler.lambda_handler"]